# Copia este archivo como .env y ajusta los valores.
# El backend lee estas variables de entorno (no hay carga automática de .env).

# Clave de firma de los tokens JWT. Obligatorio cambiarla fuera de desarrollo.
LEGALVAULT_SECRET_KEY=dev-secret-cambiar-en-produccion

# Bloqueo de cuentas (Módulo 7)
LEGALVAULT_MAX_INTENTOS=5
LEGALVAULT_MINUTOS_BLOQUEO=15

# Duración de la sesión en minutos
LEGALVAULT_MINUTOS_TOKEN=60

# Límite de tamaño de documentos en MB (Módulo 3)
LEGALVAULT_MAX_ARCHIVO_MB=25

# Cubeta de padding de las bóvedas cifradas en MB (mejora #15).
# Ambas vistas de una bóveda se rellenan a esta misma cubeta para que ocupen
# exactamente lo mismo en disco. Escalera recomendada: 1, 5 o 25.
LEGALVAULT_BOVEDA_BUCKET_MB=1

# Carpeta de datos JSON (por defecto: ./data)
# LEGALVAULT_DATA_DIR=

# Administrador inicial (solo se usa si no existe ningún usuario)
LEGALVAULT_ADMIN_USER=admin
LEGALVAULT_ADMIN_EMAIL=admin@legalvault.local
LEGALVAULT_ADMIN_PASSWORD=Admin123!
